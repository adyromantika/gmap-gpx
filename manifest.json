{
  "manifest_version": 3,
  "name": "GPX Overlay for Google Maps",
  "version": "1.1.0",
  "description": "Overlay one or many local GPX files on Google Maps. Runs fully locally.",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle GPX Overlay panel" },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://google.com/maps*",
        "https://maps.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
